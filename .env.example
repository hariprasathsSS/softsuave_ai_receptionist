# ── App ───────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-random-64-char-string
BASE_URL=http://localhost:8000

# ── Supabase (PostgreSQL) ─────────────────
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:your_db_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Redis ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Twilio ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_DEFAULT_FROM_NUMBER=+1XXXXXXXXXX

# ── Deepgram (STT + TTS — one API key) ────
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_TTS_VOICE=aura-luna-en

# ── LLM ──────────────────────────────────
# Provider: "openai" (default) or "groq" (free-tier testing)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your_openai_api_key
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your_openai_api_key

# Groq (switch LLM_PROVIDER=groq to use this)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Calendar ───────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ENCRYPTION_KEY=your_fernet_key_for_token_encryption

# ── MinIO ─────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=recordings
MINIO_SECURE=false

# ── JWT ───────────────────────────────────
JWT_SECRET_KEY=change-me-to-random-64-char-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── Celery ────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
